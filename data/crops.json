	"setting": "黑龙江省哈尔滨市宾县（古称宾州厅）· 松嫩平原黑土地",
	"seasons": {
	  "spring": "春（3-5月）解冻播种期",
	  "summer": "夏（6-8月）生长期，日照长",
	  "autumn": "秋（9-10月）收割囤积期",
	  "winter": "冬（11-2月）漫长休耕期，炕上时光"
	},
	"agriculture_note": "寒温带大陆性气候，一年一熟。春播秋收，冬季漫长休耕。所有作物均为『春播-秋收』型，无越冬作物。",
	"crop_classification": {
	  "spring_sown": "春播作物：4月下旬-5月上旬播种，9-10月秋收（玉米、大豆、水稻、春小麦、马铃薯、谷子、甜菜、亚麻）",
	  "autumn_harvest": "秋收作物:晚收作物收获季紧贴秋霜窗口,过了窗口冻死在地里",
	  "spring_sow": "春播作物:4月下旬-5月上旬播种,7-10月陆续收获 —— 早收(马铃薯7月/春小麦8月/亚麻8月,腾茬早可复种秋菜) 与 晚收(玉米/大豆/水稻/甜菜,9-10月,抢在秋霜前收完)",
	  "winter_storage": "越冬储藏:秋菜/马铃薯窖藏腌渍(酸菜/咸菜),晚收作物晾晒入囷(玉米辫子挂房梁)",
	  "replant": "复种:早收作物腾茬后,7月可复种一茬「秋菜」—— 一年一熟大原则下的唯一例外,也是黑龙江真实的「抢茬秋菜」农法"
	},
	"frost_rule": "早霜/初霜在9月末-10月,作物收获窗口结束即冻死;晚霜在5月,错过播种窗当年无收",
	"harvest_window_semantics": "harvest_window = [起始月, 结束月] 连续区间",
	"window_semantics": "plant_window / harvest_window 均为连续区间 [起始月, 结束月],单月写作 [m, m]"
